# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# JWT Configuration (RS256 Public Key File Path)
JWT_PUBLIC_KEY_PATH=/path/to/your/public-key.pem


NODE_ENV = "development"

# S3 Storage Configuration
S3_STORAGE_ENDPOINT=localhost
S3_STORAGE_PORT=3000
S3_STORAGE_USE_SSL=false
S3_STORAGE_ACCESS_KEY=minioadmin
S3_STORAGE_SECRET_KEY=minioadmin
S3_STORAGE_BUCKET=jitsi

# File Storage Configuration
UPLOAD_DIR=./uploads
USE_S3_STORAGE=false

# Production Example:
# BASE_URL=https://your-domain.com/file-service
# JWT_PUBLIC_KEY_PATH=/etc/ssl/certs/jwt-public-key.pem
# S3_STORAGE_ENDPOINT=minio.your-domain.com
# S3_STORAGE_PORT=443
# S3_STORAGE_USE_SSL=true
# S3_STORAGE_ACCESS_KEY=your-production-access-key
# S3_STORAGE_SECRET_KEY=your-production-secret-key
# S3_STORAGE_BUCKET=jitsi-prod
# UPLOAD_DIR=/var/www/jitsi-meet-file-sharing-service/uploads